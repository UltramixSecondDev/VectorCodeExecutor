-- Syntax Highlighter Engine Logic
local insideBlockComment = false

local function tokenize(line)
    local tokens = {}
    local i = 1

    if insideBlockComment then
        local endPos = line:find("]]", 1, true)
        if endPos then
            table.insert(tokens, {line:sub(1, endPos + 1), "Comment"})
            insideBlockComment = false
            if endPos + 1 < #line then
                local rest = line:sub(endPos + 2)
                for _, t in ipairs(tokenize(rest)) do
                    table.insert(tokens, t)
                end
            end
        else
            table.insert(tokens, {line, "Comment"})
        end
        return tokens
    end

    while i <= #line do
        local c = line:sub(i, i)

        if c == "-" and line:sub(i, i + 3) == "--[[" then
            local endPos = line:find("]]", i + 4, true)
            if endPos then
                table.insert(tokens, {line:sub(i, endPos + 1), "Comment"})
                i = endPos + 2
            else
                table.insert(tokens, {line:sub(i), "Comment"})
                insideBlockComment = true
                break
            end
        elseif c == "-" and line:sub(i, i + 1) == "--" then
            table.insert(tokens, {line:sub(i), "Comment"})
            break
        elseif c == '"' or c == "'" then
            local quote = c
            local j = i + 1
            while j <= #line do
                if line:sub(j, j) == quote and line:sub(j - 1, j - 1) ~= "\\" then break end
                j = j + 1
            end
            table.insert(tokens, {line:sub(i, j), "String"})
            i = j
        elseif c:match("%d") then
            local j = i
            while j <= #line and line:sub(j, j):match("[%d%.]") do
                j = j + 1
            end
            table.insert(tokens, {line:sub(i, j - 1), "Number"})
            i = j - 1
        elseif line:sub(i, i + 3) == "true" then
            table.insert(tokens, {"true", "Number"})
            i = i + 3
        elseif line:sub(i, i + 4) == "false" then
            table.insert(tokens, {"false", "Number"})
            i = i + 4
        elseif line:sub(i, i + 2) == "nil" then
            table.insert(tokens, {"nil", "Number"})
            i = i + 2
        elseif c:match("[%a_]") then
            local j = i
            while j <= #line and line:sub(j, j):match("[%w_]") do
                j = j + 1
            end
            table.insert(tokens, {line:sub(i, j - 1), "Word"})
            i = j - 1
        else
            table.insert(tokens, {c, "Operator"})
        end
        i = i + 1
    end
    return tokens
end

local function detectType(tokens, index)
    local token = tokens[index]
    local val, typ = token[1], token[2]
    
    if typ ~= "Word" then return typ end
    
    if Keywords[val] then return "Keyword" end
    if BuiltIns[val] then return "BuiltIn" end
    if SpecialMethods[val] then return "LocalMethod" end
    
    if index > 1 and tokens[index - 1][1] == "." then return "LocalProperty" end
    if index > 1 and tokens[index - 1][1] == ":" then return "LocalMethod" end
    
    if val == "self" then return "Self" end
    if val == "true" or val == "false" then return "Bool" end
    if val == "nil" then return "Nil" end
    if index > 1 and tokens[index - 1][1] == "function" then return "FunctionName" end
    
    return "Text"
end

local function colorToHex(c)
    return string.format("#%02x%02x%02x", 
        math.floor(c.R * 255), 
        math.floor(c.G * 255), 
        math.floor(c.B * 255)
    )
end

local function highlightLine(line)
    local tokens = tokenize(line)
    local out = ""
    for i, token in ipairs(tokens) do
        local ttype = detectType(tokens, i)
        local color = SyntaxColors[ttype] or SyntaxColors.Text
        out = out .. string.format(
            '<font color="%s">%s</font>',
            colorToHex(color),
            token[1]:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
        )
    end
    return out
end

local function updateEditorHighlight()
    for _, c in ipairs(highlightContainer:GetChildren()) do
        c:Destroy()
    end

    local text = editorBox.Text or ""
    local lines = {}
    local longestLen = 0
    
    for line in text:gmatch("([^\n]*)\n?") do
        table.insert(lines, line)
        if #line > longestLen then longestLen = #line end
    end

    local lineHeight = 18
    local yOffset = 0
    local charWidth = 7
    local contentWidth = math.max(200, editorScroll.AbsoluteSize.X - 20)
    contentWidth = math.max(contentWidth, longestLen * charWidth + 50)

    for i, line in ipairs(lines) do
        local leadingSpaces = string.match(line, "^%s*")
        local indentCount = leadingSpaces and math.floor(#leadingSpaces / 4) or 0
        
        local isBlockStarter = line:match("%f[%w]function%f[%W]") 
                            or line:match("%f[%w]if%f[%W]") 
                            or line:match("%f[%w]for%f[%W]") 
                            or line:match("%f[%w]while%f[%W]") 
                            or line:match("%f[%w]do%f[%W]")
                            or line:match("%f[%w]repeat%f[%W]")

        for level = 1, indentCount do
            local indentX = (level * 24) - 12
            
            local indentLine = Instance.new("Frame")
            indentLine.Size = UDim2.new(0, 1, 0, lineHeight)
            indentLine.Position = UDim2.new(0, indentX, 0, yOffset)
            indentLine.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
            indentLine.BorderSizePixel = 0
            indentLine.ZIndex = 1
            indentLine.Parent = highlightContainer

            if isBlockStarter and level == indentCount then
                local blockIndicator = Instance.new("TextLabel")
                blockIndicator.Size = UDim2.new(0, 14, 0, lineHeight)
                blockIndicator.Position = UDim2.new(0, indentX - 7, 0, yOffset)
                blockIndicator.BackgroundTransparency = 1
                blockIndicator.Text = "▶"
                blockIndicator.TextColor3 = colors.textGray
                blockIndicator.TextSize = 8
                blockIndicator.FontFace = customFont
                blockIndicator.ZIndex = 2
                blockIndicator.Parent = highlightContainer
            end
        end

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, contentWidth, 0, lineHeight)
        lbl.Position = UDim2.new(0, 0, 0, yOffset)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.Code
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Top
        lbl.RichText = true
        lbl.TextWrapped = false
        lbl.Text = highlightLine(line)
        lbl.ZIndex = 2
        lbl.Parent = highlightContainer

        yOffset = yOffset + lineHeight
    end

    local buffer = {}
    for i = 1, #lines do buffer[#buffer+1] = tostring(i) end
    lineNums.Text = table.concat(buffer, "\n")
    
    local requiredHeight = math.max(yOffset, editorMainContainer.AbsoluteSize.Y)
    editorBox.Size = UDim2.new(0, contentWidth, 0, requiredHeight)
    editorScroll.CanvasSize = UDim2.new(0, contentWidth, 0, requiredHeight)
end

