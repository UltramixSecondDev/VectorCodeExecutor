local function renderTreeView()
    for _, child in ipairs(instanceScroll:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    allNodeButtons = {}
    
    local filterText = searchBox.Text:lower()
    local rootServices = {
        game:GetService("Workspace"),
        game:GetService("Players"),
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        game:GetService("StarterGui"),
        game:GetService("StarterPack"),
        game:GetService("Lighting")
    }
    
    local function createNode(parentContainer, item, depth)
        local matchesFilter = true
        if filterText ~= "" then
            local function checkDeepMatch(target)
                if string.find(target.Name:lower(), filterText) then return true end
                for _, desc in ipairs(target:GetChildren()) do
                    if checkDeepMatch(desc) then return true end
                end
                return false
            end
            matchesFilter = checkDeepMatch(item)
        end
        
        if not matchesFilter then return end
        
        local btn = Instance.new("TextButton", parentContainer)
        btn.Size = UDim2.new(1, 0, 0, 22)
        btn.BackgroundTransparency = 1
        btn.Text = string.rep("    ", depth) .. "   " .. item.Name
        btn.TextColor3 = colors.textWhite
        btn.FontFace = customFont
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        
        allNodeButtons[btn] = item
        
        local icon = Instance.new("ImageLabel", btn)
        icon.Size = UDim2.new(0, 14, 0, 14)
        icon.Position = UDim2.new(0, (depth * 16) + 4, 0.5, -7)
        icon.BackgroundTransparency = 1
        icon.Image = "rbxassetid://127958936237605"
        icon.ImageColor3 = colors.accent
        
        local childrenContainer = Instance.new("Frame", parentContainer)
        childrenContainer.Size = UDim2.new(1, 0, 0, 0)
        childrenContainer.BackgroundTransparency = 1
        childrenContainer.Visible = false
        
        local subLayout = Instance.new("UIListLayout", childrenContainer)
        subLayout.SortOrder = Enum.SortOrder.LayoutOrder
        
        subLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if childrenContainer.Visible then
                childrenContainer.Size = UDim2.new(1, 0, 0, subLayout.AbsoluteContentSize.Y)
            end
        end)
        
        btn.MouseButton1Click:Connect(function()
            if item:IsA("LocalScript") or item:IsA("ModuleScript") or item:IsA("Script") then
                activeTargetScript = item
                
                if multiSelectEnabled then
                    local foundIdx = table.find(selectedScriptsForExport, item)
                    if foundIdx then
                        table.remove(selectedScriptsForExport, foundIdx)
                    else
                        table.insert(selectedScriptsForExport, item)
                    end
                else
                    selectedScriptsForExport = {item}
                end
                
                updateSelectionHighlight()
                
                local success, sourceCode = pcall(function()
                    return decompile(item)
                end)
                if success and sourceCode then
                    editorBox.Text = sourceCode
                else
                    editorBox.Text = "-- [Error]: Could not decompile this script."
                end
            else
                childrenContainer.Visible = not childrenContainer.Visible
                if childrenContainer.Visible and #childrenContainer:GetChildren() <= 1 then
                    for _, subChild in ipairs(item:GetChildren()) do
                        pcall(function() createNode(childrenContainer, subChild, depth + 1) end)
                    end
                end
                childrenContainer.Size = UDim2.new(1, 0, 0, subLayout.AbsoluteContentSize.Y)
            end
        end)
    end
    
    for _, service in ipairs(rootServices) do
        createNode(instanceScroll, service, 0)
    end
    updateSelectionHighlight()
end

