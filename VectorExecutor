local currentDropdown = nil

local function closeDropdown()
    if currentDropdown and currentDropdown.Parent then
        currentDropdown:Destroy()
        currentDropdown = nil
    end
end

local menuData = {
    File = {
        {"Load Clipboard", function() 
            local success, clip = pcall(function() return getclipboard() end)
            if success and clip then editorBox.Text = clip end
        end},
        {"Cut", function() 
            pcall(function() setclipboard(editorBox.Text) end)
            editorBox.Text = ""
        end},
        {"Save Script Bytecode", function()
            if activeTargetScript and (activeTargetScript:IsA("LocalScript") or activeTargetScript:IsA("ModuleScript") or activeTargetScript:IsA("Script")) then
                pcall(function()
                    local bytecode = getscriptbytecode(activeTargetScript)
                    local fileName = activeTargetScript.Name .. ".lua"
                    writefile(fileName, bytecode)
                    print("VectorCode: Script bytecode saved as " .. fileName)
                end)
            else
                warn("VectorCode: Select a valid script in the explorer first.")
            end
        end},
        {"CopyPath", function()
            if activeTargetScript then
                pcall(function()
                    setclipboard(activeTargetScript:GetFullName())
                    print("VectorCode: Path copied -> " .. activeTargetScript:GetFullName())
                end)
            else
                warn("VectorCode: No instance selected.")
            end
        end}
    },
    Home = {
        {"Destroy GUI", function()
            pcall(function()
                if gui and gui.Parent then gui:Destroy() end
                if player and player:FindFirstChild("PlayerGui") then
                    local fileBrowser = player.PlayerGui:FindFirstChild("FileBrowser")
                    if fileBrowser then fileBrowser:Destroy() end
                    
                    -- Asegurar que VectorOutput exista antes de destruirla al limpiar el IDE completo
                    local vectorOutput = player.PlayerGui:FindFirstChild("VectorOutput")
                    if vectorOutput then vectorOutput:Destroy() end
                end
            end)
        end}
    },
    View = {
        {"MultiSelect: " .. (multiSelectEnabled and "[ON]" or "[OFF]"), function(btnRef)
            multiSelectEnabled = not multiSelectEnabled
            btnRef.Text = "  MultiSelect: " .. (multiSelectEnabled and "[ON]" or "[OFF]")
            if not multiSelectEnabled then
                selectedScriptsForExport = {}
                updateSelectionHighlight()
            end
        end},
        {"Export Select", function()
            if not multiSelectEnabled then return end
            if #selectedScriptsForExport > 0 then
                for _, scr in ipairs(selectedScriptsForExport) do
                    pcall(function()
                        if scr:IsA("LuaSourceContainer") then
                            local code = decompile(scr)
                            writefile(scr.Name .. "_exported.lua", code)
                        end
                    end)
                end
            end
        end}
    },
    Tools = {
        {"Instance Counter", function()
            local total = #game:GetDescendants()
            print("VectorCode Info -> Total game instances: " .. total)
        end},
        {"Open Dex++ Explorer", function()
            pcall(function() loadstring(game:HttpGet("https://rawscripts.net/raw/Universal-Script-Dex-plus-plus-46438"))() end)
        end}
    }
}

for _, child in ipairs(menuBar:GetChildren()) do
    if child:IsA("TextButton") then
        local menuName = child.Text
        child.MouseButton1Click:Connect(function()
            if currentDropdown and currentDropdown.Parent == child then
                closeDropdown()
                return
            end
            closeDropdown()
            local options = menuData[menuName]
            if not options then return end
            
            local dropdown = Instance.new("Frame", child)
            dropdown.Size = UDim2.new(0, 180, 0, #options * 24 + 6)
            dropdown.Position = UDim2.new(0, 0, 1, 2)
            dropdown.BackgroundColor3 = colors.bgSub
            dropdown.BorderSizePixel = 1
            dropdown.BorderColor3 = colors.border
            dropdown.ZIndex = 10
            currentDropdown = dropdown
            
            local dropLayout = Instance.new("UIListLayout", dropdown)
            dropLayout.SortOrder = Enum.SortOrder.LayoutOrder
            
            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton", dropdown)
                optBtn.Size = UDim2.new(1, 0, 0, 24)
                optBtn.BackgroundTransparency = 1
                optBtn.Text = "  " .. opt[1]
                optBtn.TextColor3 = colors.textWhite
                optBtn.FontFace = customFont
                optBtn.TextSize = 11
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.ZIndex = 11
                
                optBtn.MouseButton1Click:Connect(function()
                    opt[2](optBtn)
                    if menuName ~= "View" or opt[1]:find("Export Select") then
                        closeDropdown()
                    end
                end)
            end
        end)
    end
end
